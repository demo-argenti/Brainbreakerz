; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="BrainBreakerz"
run/main_scene="uid://cdiawcbxtfybt"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"
boot_splash/minimum_display_time=500

[audio]

buses/default_bus_layout="uid://cdoeqplecoabj"

[autoload]

Global="*res://scripts/global.gd"
SaveLoad="res://scripts/SaveLoad.gd"
Transition="*res://objects/transition.tscn"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
Conductor="*uid://b5b2yr2im4ojy"

[dialogic]

directories/dch_directory={
"character 1": "res://VN Characters/character 1.dch"
}
directories/dtl_directory={
"Test Timeline": "res://Test Timeline.dtl",
"Test VN Scene": "res://Test VN Scene.dtl",
"test_postsong_timeline": "res://test_postsong_timeline.dtl",
"test_presong_timeline": "res://test_presong_timeline.dtl"
}
layout/style_directory={
"": "res://test_style.tres",
"test_style": "res://test_style.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://test_style.tres"]
layout/default_style="res://test_style.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={
"latency": "asfasdfas",
"scratch_text": ""
}
audio/type_sound_bus="SFX"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="BrainBreakerz"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/sm_file_importer/plugin.cfg")

[gui]

theme/custom_font="uid://cybuyfk5r8ceq"

